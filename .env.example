# iPort Configuration
# Port to listen on (default 3000)
IPORT_PORT=3000

# Host binding (0.0.0.0 allows access across local network)
IPORT_HOST=0.0.0.0

# Optional PIN/Passcode protection.
# If set, anyone visiting the web UI will be asked for this passcode.
# Leave blank for open access on your local network.
IPORT_PIN=

# Polling interval in milliseconds for new messages (default: 500)
IPORT_POLL_INTERVAL=500

# Force Demo Mode (true/false)
IPORT_DEMO=false
