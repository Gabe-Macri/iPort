{
  "name": "iport",
  "version": "1.0.0",
  "description": "Clean, fast, and minimal iMessage web relay for non-Apple devices",
  "type": "module",
  "main": "server/index.js",
  "types": "sdk/index.ts",
  "exports": {
    ".": "./server/index.js",
    "./sdk": "./sdk/index.ts"
  },
  "scripts": {
    "start": "./start.sh",
    "start:full": "./start.sh full",
    "start:api": "./start.sh api",
    "api": "node server/index.js --api",
    "dev": "./start.sh dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "server": "node server/index.js"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^6.1.0"
  },
  "keywords": [
    "imessage",
    "web",
    "relay",
    "macos",
    "sms"
  ],
  "author": "",
  "license": "MIT"
}
